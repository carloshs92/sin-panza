---
import Base from '../layouts/Base.astro';
import Dialog from '../components/Dialog.astro';
import Stepper from '../components/Stepper.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Ajustes" nav="ajustes" ancho="ancho">
  <div id="ajustes" class="stack">
    <h1>Ajustes</h1>

    <section class="card">
      <h2 class="card-title">Entrenamiento</h2>
      <p class="muted nota">Se guarda al instante.</p>
      <div class="fila">
        <span class="con-icono"><Icon nombre="timer" />Minutos por ejercicio</span>
        <Stepper id="stMin" etiqueta="Minutos" />
      </div>
      <div class="fila">
        <span class="con-icono"><Icon nombre="repeat" />Series por ejercicio</span>
        <Stepper id="stSer" etiqueta="Series" />
      </div>
      <div class="fila">
        <span class="con-icono"><Icon nombre="hourglass" /><span>Descanso entre series <small class="muted">(seg)</small></span></span>
        <Stepper id="stDes" etiqueta="Segundos de descanso" />
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Mi plan</h2>
      <p class="muted" id="planResumen">—</p>
      <div class="acciones">
        <a class="btn btn-secondary btn-sm" href="/?editar=1"><Icon nombre="pencil" /> Editar mi plan</a>
        <button class="btn btn-secondary btn-sm" id="btnRegenerar"><Icon nombre="shuffle" /> Regenerar rutinas</button>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Sin internet</h2>
      <p class="muted">Descarga las animaciones de tus rutinas para entrenar aunque te quedes sin señal.</p>
      <p class="estado-off" id="estadoOff" aria-live="polite">Comprobando…</p>
      <div class="progress oculto" id="barraDesc"><div id="barraFill"></div></div>
      <div class="acciones">
        <button class="btn btn-sm" id="btnDescargar"><Icon nombre="download" /> Descargar para usar sin internet</button>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Aplicación</h2>
      <p class="muted">Instálala en tu pantalla de inicio para abrirla como una app, a pantalla completa y sin conexión.</p>
      <div class="acciones">
        <button class="btn btn-secondary btn-sm" id="btnInstalar"><Icon nombre="smartphone" /> Añadir a pantalla de inicio</button>
      </div>
      <p class="muted oculto con-icono" id="msgInstalada"><Icon nombre="circle-check" /> Ya está instalada en este dispositivo.</p>
      <p class="muted oculto" id="msgManual">En tu navegador: abre el menú (⋮ o ≡) y busca <b>«Instalar aplicación»</b> o <b>«Añadir a pantalla de inicio»</b>.</p>
      <div class="muted oculto ios-pasos" id="iosPasos">
        En iPhone/iPad hazlo desde Safari:
        <ol>
          <li>Toca el botón <b>Compartir</b> (cuadrado con flecha).</li>
          <li>Elige <b>«Añadir a pantalla de inicio»</b>.</li>
          <li>Confirma con <b>Añadir</b>.</li>
        </ol>
      </div>
    </section>

    <section class="card">
      <h2 class="card-title">Datos</h2>
      <p class="muted">Todo se guarda solo en este dispositivo.</p>
      <div class="acciones">
        <button class="btn btn-ghost btn-sm peligro" id="btnReset"><Icon nombre="trash" /> Borrar todo y empezar de cero</button>
      </div>
    </section>

    <footer class="creditos muted">
      Ejercicios e ilustraciones: <b>© Gym visual</b> —
      <a href="https://gymvisual.com/" target="_blank" rel="noopener">gymvisual.com</a><br />
      Datos: <a href="https://github.com/hasaneyldrm/exercises-dataset" target="_blank" rel="noopener">exercises-dataset</a> (MIT)
    </footer>
  </div>

  <Dialog id="modalReset" icono="alert" tono="peligro" titulo="¿Seguro que quieres borrar todo?">
    <p>Se eliminará tu perfil, tus rutinas y todo tu historial de entrenamientos. <b>Esta acción no se puede deshacer.</b></p>
    <button slot="acciones" class="btn btn-danger" id="btnResetConfirmar">Sí, borrar todo</button>
    <button slot="acciones" class="btn btn-secondary" id="btnResetCancelar">Cancelar</button>
  </Dialog>
</Base>

<style>
  /* ≥ 900: las tarjetas en dos columnas (flujo por columnas, sin huecos) */
  @media (min-width: 900px) {
    #ajustes { display: block; columns: 2; column-gap: var(--s-4); }
    #ajustes > * { break-inside: avoid; margin-bottom: var(--s-4); }
    #ajustes > h1, #ajustes > .creditos { column-span: all; }
  }
  .card { display: flex; flex-direction: column; gap: var(--s-3); }
  .card-title { margin-bottom: 0; }
  .card p { font-size: var(--t-sm); }
  .nota { margin-top: calc(-1 * var(--s-2)); font-size: var(--t-xs) !important; }

  /* La etiqueta se parte en dos líneas antes que mandar el stepper abajo */
  .fila { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--t-sm); color: var(--fg-muted); }
  .fila > span { flex: 1; min-width: 0; align-items: flex-start; }
  .fila .icon { margin-top: 1px; color: var(--fg-subtle); }
  .fila :global(.stepper) { flex-shrink: 0; }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .peligro { color: var(--danger); padding-inline: 0; }

  .estado-off { display: flex; align-items: flex-start; gap: var(--s-2); font-weight: 600; }
  .estado-off.listo { color: var(--success); }
  .estado-off.falta { color: var(--warning); }

  .ios-pasos { font-size: var(--t-sm); }
  .ios-pasos ol { margin: var(--s-2) 0 0 var(--s-5); }

  .creditos { padding: var(--s-2) 0; font-size: var(--t-xs); text-align: center; }
  .creditos a { text-decoration: underline; }
</style>

<script>
  import { getProfile, getSettings, saveSettings, getRoutines, saveRoutines, resetAll, DIAS, CATEGORIAS, IDIOMAS, EQUIPOS } from '../lib/db.js';
  import { cargarEjercicios, generarRutinas } from '../lib/plan.js';
  import { urlsDeRutinas, cuantoFalta, descargar, hayCache } from '../lib/media.js';
  import { conectarStepper, toast } from '../lib/ui.js';
  import { conIcono } from '../lib/iconos.js';
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('ajustes');
    if (!root) return;

    const perfil = getProfile();
    if (!perfil) {
      navigate('/', { history: 'replace' });
      return;
    }

    const $ = (id) => root.querySelector('#' + id);
    // Guardado al instante, como el editor de rutinas
    const guardar = (campo) => (valor) => {
      saveSettings({ ...getSettings(), [campo]: valor });
      toast('Guardado');
    };
    const s = getSettings();
    conectarStepper($('stMin'), { min: 1, max: 10, valor: s.minPorEjercicio, onCambio: guardar('minPorEjercicio') });
    conectarStepper($('stSer'), { min: 1, max: 8, valor: s.series, onCambio: guardar('series') });
    conectarStepper($('stDes'), { min: 3, max: 60, valor: s.descansoSeg, onCambio: guardar('descansoSeg') });

    const cats = perfil.categorias.map((c) => CATEGORIAS.find((x) => x.id === c)?.label ?? c).join(', ');
    const dias = perfil.dias.map((d) => DIAS.find((x) => x.id === d)?.corto).join(' · ');
    const idioma = IDIOMAS.find((x) => x.id === perfil.idioma);
    const equipo = (perfil.equipo || []).map((e) => EQUIPOS.find((x) => x.id === e)?.label ?? e).join(', ');
    $('planResumen').textContent =
      `${perfil.edad} años · ${perfil.tiempoMin} min/día · ${cats} · Días: ${dias}` +
      (idioma ? ` · ${idioma.label}` : '') +
      (equipo ? ` · Equipo: ${equipo}` : '');

    $('btnRegenerar').addEventListener('click', async () => {
      $('btnRegenerar').disabled = true;
      $('btnRegenerar').textContent = 'Generando…';
      const ejercicios = await cargarEjercicios(perfil.idioma);
      saveRoutines(generarRutinas(perfil, ejercicios, getSettings()));
      navigate('/rutinas');
    });

    // ---- descarga para usar sin internet ----
    const urlsOff = urlsDeRutinas(getRoutines());
    const mb = (b) => (b / 1048576).toFixed(1) + ' MB';

    async function pintarEstadoOff() {
      const el = $('estadoOff');
      if (!hayCache()) {
        el.textContent = 'Este navegador no permite guardar contenido sin conexión.';
        $('btnDescargar').disabled = true;
        return;
      }
      if (urlsOff.length === 0) {
        el.textContent = 'Aún no tienes rutinas que descargar.';
        $('btnDescargar').disabled = true;
        return;
      }
      const { guardados, total } = await cuantoFalta(urlsOff);
      if (guardados >= total) {
        el.innerHTML = conIcono('circle-check', `Listo: ${total} archivos guardados. Puedes entrenar sin internet.`);
        el.className = 'estado-off listo';
        $('btnDescargar').innerHTML = conIcono('refresh', 'Volver a comprobar');
        $('btnDescargar').className = 'btn btn-secondary btn-sm';
      } else {
        el.textContent = `Faltan ${total - guardados} de ${total} archivos por guardar.`;
        el.className = 'estado-off falta';
        $('btnDescargar').innerHTML = conIcono('download', 'Descargar para usar sin internet');
        $('btnDescargar').className = 'btn btn-sm';
      }
    }

    $('btnDescargar').addEventListener('click', async () => {
      const btn = $('btnDescargar');
      btn.disabled = true;
      $('barraDesc').classList.remove('oculto');
      try {
        await descargar(urlsOff, ({ hechos, total, bytes }) => {
          $('barraFill').style.width = `${(hechos / total) * 100}%`;
          $('estadoOff').textContent = `Descargando ${hechos} de ${total}… (${mb(bytes)})`;
          $('estadoOff').className = 'estado-off';
        });
      } catch (err) {
        $('estadoOff').textContent = 'No se pudo descargar: ' + err.message;
      }
      btn.disabled = false;
      $('barraDesc').classList.add('oculto');
      $('barraFill').style.width = '0%';
      pintarEstadoOff();
    });

    pintarEstadoOff();

    // ---- instalación en pantalla de inicio (PWA) ----
    const btnInstalar = $('btnInstalar');
    const esIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const yaInstalada = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;

    if (yaInstalada) {
      btnInstalar.classList.add('oculto');
      $('msgInstalada').classList.remove('oculto');
    }

    btnInstalar.addEventListener('click', async () => {
      const prompt = window.__installPrompt;
      if (prompt) {
        prompt.prompt();
        const { outcome } = await prompt.userChoice;
        if (outcome === 'accepted') {
          window.__installPrompt = null;
          btnInstalar.classList.add('oculto');
          $('msgInstalada').classList.remove('oculto');
        }
      } else if (esIOS) {
        $('iosPasos').classList.toggle('oculto');
      } else {
        $('msgManual').classList.toggle('oculto');
      }
    });

    // ---- borrar todo, con alerta de confirmación ----
    const modal = document.getElementById('modalReset');
    $('btnReset').addEventListener('click', () => modal.showModal());
    document.getElementById('btnResetCancelar').addEventListener('click', () => modal.close());
    // Tocar fuera del cuadro (sobre el fondo) también cancela
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    document.getElementById('btnResetConfirmar').addEventListener('click', () => {
      resetAll();
      navigate('/', { history: 'replace' });
    });
  });
</script>
