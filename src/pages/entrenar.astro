---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Dialog from '../components/Dialog.astro';
import Sheet from '../components/Sheet.astro';
import Stepper from '../components/Stepper.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Entrenando">
  <!-- data-fase (espera | cuenta | trabajo | descanso | fin) decide qué se ve -->
  <div id="player" data-fase="espera">
    <div class="cabecera">
      <TopBar volver="/rutinas" volverId="btnVolver" tituloId="pDia" subId="pPos" />
      <div class="progress"><div id="pBarra"></div></div>
    </div>

    <!-- Vista de ejercicio -->
    <section id="vistaEjercicio" class="escena">
      <figure class="media">
        <div class="media-frame">
          <img id="exGif" src="" alt="Demostración del ejercicio" />
          <figcaption class="credito">© <a href="https://gymvisual.com/" target="_blank" rel="noopener">Gym visual</a></figcaption>
        </div>
      </figure>

      <div class="info">
        <div class="ex-titulo">
          <h2 id="exNombre">—</h2>
          <div class="ex-tags" id="exTags"></div>
        </div>

        <div class="series-dots" id="seriesDots" aria-hidden="true"></div>

        <!-- Estado: esperando el arranque -->
        <div class="estado" id="estEspera">
          <p class="voz-msg" id="vozMsg">Toca <b>Empezar</b> cuando estés en posición</p>
          <p class="muted voz-estado" id="vozEstado"></p>
        </div>

        <!-- Estado: cuenta atrás previa -->
        <div class="estado oculto" id="estCuenta">
          <div class="cuenta-num" id="cuentaNum">3</div>
          <p class="cuenta-msg">Prepárate…</p>
        </div>

        <!-- Estado: trabajando / descanso -->
        <div class="estado oculto" id="estTimer">
          <button class="timer-wrap" id="timerWrap" aria-label="Pausar o seguir">
            <svg viewBox="0 0 200 200" class="timer-svg" aria-hidden="true">
              <circle cx="100" cy="100" r="88" class="t-bg" />
              <circle cx="100" cy="100" r="88" class="t-fg" id="tArco" />
            </svg>
            <span class="timer-centro">
              <span class="t-fase" id="tFase">SERIE 1</span>
              <b class="t-num" id="tNum">0:45</b>
              <span class="t-hint" id="tHint"></span>
            </span>
          </button>
        </div>
      </div>
    </section>

    <!-- Vista final -->
    <section id="vistaFin" class="oculto">
      <div class="fin">
        <div class="fin-emoji" aria-hidden="true">🏆</div>
        <h2>¡Entrenamiento completado!</h2>
        <p class="muted" id="finResumen">—</p>
        <a href="/rutinas" class="btn">Volver a mis rutinas</a>
      </div>
    </section>

    <!-- Barra de acción: siempre a mano, pegada abajo -->
    <div class="barra-accion">
      <div class="barra-fila" id="barEspera">
        <button class="icon-btn" id="btnPasos" aria-label="Cómo se hace"><Icon nombre="book" /></button>
        <button class="icon-btn" id="btnAjustar" aria-label="Ajustar minutos y series"><Icon nombre="sliders" /></button>
        <button class="btn" id="btnManual"><Icon nombre="play" /> Empezar</button>
        <button class="icon-btn mic" id="btnMic" aria-pressed="false" aria-label="Control por voz"><Icon nombre="mic-off" /></button>
      </div>
      <div class="barra-fila" id="barTimer">
        <button class="btn btn-secondary" id="btnPausa"><Icon nombre="pause" /> Pausar</button>
        <button class="btn btn-ghost btn-sm" id="btnSaltar">Saltar <Icon nombre="skip-forward" /></button>
      </div>
    </div>

    <!-- Anuncios para lectores de pantalla: cambios de fase, no cada segundo -->
    <p class="visually-hidden" id="anuncio" aria-live="polite"></p>

    <Sheet id="sheetAjustes" titulo="Ajustar ejercicio">
      <div class="cfg">
        <span class="con-icono"><Icon nombre="timer" />Minutos por ejercicio</span>
        <Stepper id="stMin" etiqueta="Minutos" />
      </div>
      <div class="cfg">
        <span class="con-icono"><Icon nombre="repeat" />Series</span>
        <Stepper id="stSer" etiqueta="Series" />
      </div>
      <p class="muted nota">Se guarda también para los próximos entrenamientos.</p>
    </Sheet>

    <Sheet id="sheetPasos" titulo="Cómo se hace">
      <button class="btn btn-secondary btn-sm btn-leer" id="btnLeer"><Icon nombre="volume" /> Escuchar instrucciones</button>
      <ol class="pasos" id="exPasos"></ol>
    </Sheet>

    <!-- Alerta al intentar salir con el entrenamiento en curso -->
    <Dialog id="modalSalir" icono="log-out" tono="peligro" titulo="¿Salir del entrenamiento?">
      <p>Perderás el progreso de esta sesión. Tendrás que empezar de nuevo.</p>
      <button slot="acciones" class="btn btn-danger" id="btnSalirSi">Sí, salir</button>
      <button slot="acciones" class="btn btn-secondary" id="btnSalirNo">Seguir entrenando</button>
    </Dialog>

    <!-- Reanudar un entrenamiento que quedó a medias -->
    <Dialog id="modalReanudar" icono="history" titulo="Tienes un entrenamiento a medias">
      <p id="reanudarInfo">—</p>
      <button slot="acciones" class="btn" id="btnReanudarSi"><Icon nombre="play" /> Continuar donde iba</button>
      <button slot="acciones" class="btn btn-secondary" id="btnReanudarNo">Empezar de nuevo</button>
    </Dialog>
  </div>
</Base>

<style>
  /* La pantalla ocupa exactamente el alto visible: todo lo esencial sin scroll
     y la barra de acción siempre abajo. */
  #player {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-height: calc(100svh - var(--shell-top) - var(--shell-bottom));
  }
  .cabecera { display: flex; flex-direction: column; gap: var(--s-3); }

  .escena { flex: 1; display: flex; flex-direction: column; gap: var(--s-3); }
  .info { flex: 1; display: flex; flex-direction: column; gap: var(--s-3); }

  /* ---- ilustración ---- */
  .media .media-frame {
    position: relative;
    display: flex; justify-content: center;
    height: clamp(140px, 34svh, 340px);
    border-radius: var(--r-lg);
    transition: height var(--dur-3) var(--ease-out);
  }
  .media img { width: auto; max-width: 100%; }
  /* Mientras corre el tiempo manda el timer: la ilustración se encoge */
  #player:is([data-fase='cuenta'], [data-fase='trabajo'], [data-fase='descanso']) .media .media-frame { height: clamp(110px, 22svh, 240px); }
  .credito {
    position: absolute; right: var(--s-2); bottom: var(--s-1);
    font-size: var(--t-xs); color: var(--surface-3);
  }
  .credito a { text-decoration: underline; }

  /* ---- ejercicio ---- */
  .ex-titulo { display: flex; flex-direction: column; gap: var(--s-2); }
  .ex-titulo h2 { font-size: var(--t-xl); text-transform: capitalize; }
  .ex-tags { display: flex; flex-wrap: wrap; gap: var(--s-1); }
  #player:not([data-fase='espera']) .ex-tags { display: none; }

  .series-dots { display: flex; justify-content: center; gap: var(--s-2); }
  .series-dots :global(span) {
    width: 12px; height: 12px; border-radius: var(--r-full);
    background: var(--surface-2); box-shadow: inset 0 0 0 1.5px var(--line-strong);
    transition: background var(--dur-2), transform var(--dur-2) var(--ease-out);
  }
  .series-dots :global(span.hecha) { background: var(--success); box-shadow: none; }
  .series-dots :global(span.actual) { background: var(--accent); box-shadow: none; transform: scale(1.3); }

  .estado { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--s-2); text-align: center; }

  .voz-msg { font-size: var(--t-lg); }
  .voz-msg :global(b) { color: var(--fg); }
  .voz-msg.escuchando { color: var(--success); }
  .voz-estado { font-size: var(--t-sm); }
  .voz-estado:empty { display: none; }

  /* ---- cuenta atrás ---- */
  .cuenta-num { font-size: var(--t-display); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; color: var(--accent); }
  .cuenta-num.pop { animation: cuenta-pop 0.55s var(--ease-out); }
  .cuenta-msg { font-size: var(--t-sm); letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-muted); }
  @keyframes cuenta-pop {
    from { transform: scale(1.6); opacity: 0.2; }
    to { transform: scale(1); opacity: 1; }
  }

  /* ---- timer: tan grande como quepa; el número escala con el círculo ---- */
  .timer-wrap {
    position: relative;
    width: min(70vmin, 420px, 42svh);
    aspect-ratio: 1;
    container-type: inline-size;
    border-radius: var(--r-full);
  }
  .timer-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .t-bg { fill: none; stroke: var(--surface-2); stroke-width: 10; }
  .t-fg {
    fill: none; stroke: var(--accent); stroke-width: 10; stroke-linecap: round;
    stroke-dasharray: 552.9; stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.95s linear, stroke var(--dur-2);
  }
  .timer-wrap.descanso .t-fg { stroke: var(--warning); }
  .timer-wrap.pausado .t-fg { stroke: var(--fg-subtle); }
  .timer-centro { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--s-1); }
  .t-fase { font-size: min(var(--t-sm), 6cqi); font-weight: 700; letter-spacing: 0.14em; color: var(--fg-muted); }
  .timer-wrap.descanso .t-fase { color: var(--warning); }
  .t-num { font-size: min(var(--t-display), 26cqi); font-weight: 800; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .timer-wrap.pausado .t-num { color: var(--fg-muted); }
  .t-hint { min-height: 1lh; font-size: var(--t-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-muted); }

  /* ---- barra de acción ---- */
  .barra-accion {
    position: sticky;
    bottom: 0;
    z-index: 10;
    margin-inline: calc(-1 * var(--s-4));
    padding: var(--s-3) var(--s-4) calc(var(--s-3) + env(safe-area-inset-bottom, 0px));
    margin-bottom: calc(-1 * var(--shell-bottom));
    background: var(--bar-bg);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
  }
  .barra-fila { display: none; align-items: center; gap: var(--s-2); }
  /* El botón principal cede ancho antes que empujar el micrófono fuera (320 px) */
  .barra-fila .btn:not(.btn-sm) { flex: 1; min-width: 0; padding-inline: var(--s-3); }
  #player[data-fase='espera'] #barEspera,
  #player:is([data-fase='trabajo'], [data-fase='descanso']) #barTimer { display: flex; }
  #player:is([data-fase='cuenta'], [data-fase='fin']) .barra-accion { display: none; }

  .mic[aria-pressed='true'] { color: var(--success); box-shadow: inset 0 0 0 1.5px var(--success); }

  /* ---- paneles ---- */
  .cfg { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); font-size: var(--t-sm); color: var(--fg-muted); }
  .nota { font-size: var(--t-xs); }
  .btn-leer { align-self: flex-start; }
  .btn-leer.leyendo { color: var(--focus); box-shadow: inset 0 0 0 1px var(--focus); }
  .pasos { display: flex; flex-direction: column; gap: var(--s-2); padding-left: var(--s-5); font-size: var(--t-sm); color: var(--fg-muted); }

  /* ---- final ---- */
  #vistaFin { flex: 1; display: flex; align-items: center; }
  #vistaFin.oculto { display: none; }
  .fin { width: 100%; display: flex; flex-direction: column; align-items: center; gap: var(--s-4); text-align: center; }
  .fin-emoji { font-size: var(--t-display); line-height: 1; animation: aparecer var(--dur-3) var(--ease-out) both; }
  .fin h2 { font-size: var(--t-xl); }

  /* ---- horizontal en el móvil (apoyado en el suelo) ----
     Ilustración a la izquierda, timer y acciones a la derecha. Mientras corre
     el tiempo desaparece la cabecera para darle todo el alto al timer. */
  @media (orientation: landscape) and (max-height: 540px) {
    :global(.shell:has(> #player)) { max-width: none; }
    /* Alto fijo (no mínimo): así las filas son definidas y el timer puede
       medirse contra el hueco real que le queda */
    #player {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      column-gap: var(--s-5);
      height: calc(100svh - var(--shell-top) - var(--shell-bottom));
      min-height: 0;
    }
    .cabecera { grid-column: 1 / -1; }
    .escena { display: contents; }
    .media { grid-column: 1; grid-row: 2 / 4; display: flex; }
    .media .media-frame,
    #player:is([data-fase='cuenta'], [data-fase='trabajo'], [data-fase='descanso']) .media .media-frame { flex: 1; height: auto; }
    .info { grid-column: 2; grid-row: 2; min-height: 0; }
    .barra-accion { grid-column: 2; grid-row: 3; margin-inline: 0; border-top: none; border-radius: var(--r-lg) var(--r-lg) 0 0; }
    #vistaFin { grid-column: 1 / -1; grid-row: 2 / 4; }

    #player:is([data-fase='trabajo'], [data-fase='descanso']) .cabecera { display: none; }
    /* Con el tiempo corriendo, la ilustración ya identifica el ejercicio: el
       alto que ocupaba el título pasa al timer */
    #player:is([data-fase='trabajo'], [data-fase='descanso']) .ex-titulo { display: none; }
    #estTimer { min-height: 0; container-type: size; }
    .timer-wrap { width: min(100cqw, 100cqh); }
  }
</style>

<script>
  import { getProfile, getRoutines, getSettings, saveSettings, addHistory, getHistory, calcularRacha, getSesion, saveSesion, clearSesion, DIAS } from '../lib/db.js';
  import {
    initAudio, sonidoTap, sonidoCuenta, sonidoInicio, sonidoUltimos,
    sonidoTick, sonidoFinSerie, sonidoSerie, sonidoEjercicio, sonidoFin,
  } from '../lib/audio.js';
  import { soportaVoz, crearEscucha, vozDe } from '../lib/voice.js';
  import { soportaTTS, leer, callar } from '../lib/tts.js';
  import { mediaUrl, precargar } from '../lib/media.js';
  import { segundosPorSerie as calcSegundosPorSerie } from '../lib/plan.js';
  import { musculo, equipamiento } from '../lib/textos.js';
  import { conectarStepper, conectarSheet } from '../lib/ui.js';
  import { icono, conIcono } from '../lib/iconos.js';
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('player');
    if (!root) return;

    const $ = (id) => root.querySelector('#' + id);
    const dia = new URLSearchParams(location.search).get('dia');
    const rutina = getRoutines()[dia] || [];
    const perfil = getProfile();
    if (!perfil) {
      navigate('/', { history: 'replace' });
      return;
    }
    // Un día sin ejercicios (los quitaste todos) manda al editor
    if (rutina.length === 0) {
      navigate(`/editar?dia=${dia}`, { history: 'replace' });
      return;
    }
    const voz = vozDe(perfil.idioma);
    const sheetAjustes = conectarSheet($('sheetAjustes'));
    const sheetPasos = conectarSheet($('sheetPasos'));

    const settings = getSettings();
    const CIRC = 2 * Math.PI * 88; // circunferencia del arco del timer

    const st = {
      idx: 0,
      serie: 0,           // series completadas del ejercicio actual
      fase: 'espera',     // espera | cuenta | trabajo | descanso | fin
      restante: 0,
      total: 0,
      pausado: false,
      timerId: null,
      inicio: Date.now(),
      sesionActiva: false, // true desde el primer arranque hasta terminar/salir
      minPorEjercicio: settings.minPorEjercicio,
      series: settings.series,
      descanso: settings.descansoSeg,
    };

    let escucha = null;
    let wakeLock = null;

    // Minutos y series se ajustan aquí mismo y se guardan como ajuste global
    const alAjustar = (campo) => (valor) => {
      st[campo] = valor;
      sonidoTap();
      saveSettings({ ...getSettings(), minPorEjercicio: st.minPorEjercicio, series: st.series });
      renderDots();
    };
    const fijarMin = conectarStepper($('stMin'), { min: 1, max: 10, valor: st.minPorEjercicio, onCambio: alAjustar('minPorEjercicio') });
    const fijarSer = conectarStepper($('stSer'), { min: 1, max: 8, valor: st.series, onCambio: alAjustar('series') });

    const segundosPorSerie = () => calcSegundosPorSerie(st.minPorEjercicio, st.series);
    const fmt = (s) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

    // ---------- render ----------
    // Pinta el ejercicio actual SIN tocar la fase (para poder reanudar en pleno timer)
    function pintarEjercicioActual() {
      const ex = rutina[st.idx];
      $('pDia').textContent = DIAS.find((d) => d.id === dia)?.label ?? dia;
      $('pPos').textContent = `Ejercicio ${st.idx + 1} de ${rutina.length}`;
      $('pBarra').style.width = `${(st.idx / rutina.length) * 100}%`;
      $('exGif').src = mediaUrl(ex.gif);
      $('exNombre').textContent = ex.name;
      $('exTags').innerHTML = `
        <span class="tag">${musculo(ex.target)}</span>
        <span class="tag">${equipamiento(ex.equipment)}</span>`;
      $('exPasos').innerHTML = ex.steps.map((s) => `<li>${s}</li>`).join('');
      fijarMin(st.minPorEjercicio);
      fijarSer(st.series);
      renderDots();
      // El GIF del siguiente ejercicio se descarga mientras haces este
      const sig = rutina[st.idx + 1];
      if (sig) precargar([sig.gif]);
    }

    function renderEjercicio() {
      pintarEjercicioActual();
      mostrarEstado('espera');
    }

    // Guarda el progreso para reanudar si se sale por error o se recarga
    function persistir() {
      if (!st.sesionActiva || st.fase === 'fin') return;
      saveSesion({
        dia, idx: st.idx, serie: st.serie, fase: st.fase,
        restante: st.restante, total: st.total, pausado: st.pausado,
        minPorEjercicio: st.minPorEjercicio, series: st.series, descanso: st.descanso,
        inicio: st.inicio, ts: Date.now(),
      });
    }

    function renderDots() {
      $('seriesDots').innerHTML = Array.from({ length: st.series }, (_, i) => {
        const cls = i < st.serie ? 'hecha' : i === st.serie && st.fase !== 'espera' ? 'actual' : '';
        return `<span class="${cls}"></span>`;
      }).join('');
    }

    function mostrarEstado(fase) {
      st.fase = fase;
      root.dataset.fase = fase; // el CSS decide barra, tamaños y qué se ve
      $('estEspera').classList.toggle('oculto', fase !== 'espera');
      $('estCuenta').classList.toggle('oculto', fase !== 'cuenta');
      $('estTimer').classList.toggle('oculto', fase !== 'trabajo' && fase !== 'descanso');
    }

    // Texto para lectores de pantalla en cada cambio de fase
    const anunciar = (texto) => { $('anuncio').textContent = texto; };

    // ---------- timer ----------
    function arrancarCuenta(segundos, fase) {
      clearInterval(st.timerId);
      st.restante = segundos;
      st.total = segundos;
      st.fase = fase;
      st.pausado = false;
      pintarTimer();
      st.timerId = setInterval(tick, 1000);
    }

    function tick() {
      if (st.pausado) return;
      st.restante--;
      // Ticks sonoros en el descanso y aviso en los últimos 5 s de trabajo
      if (st.fase === 'descanso' && st.restante > 0) sonidoTick();
      if (st.fase === 'trabajo' && st.restante > 0 && st.restante <= 5) sonidoUltimos();
      if (st.restante <= 0) {
        clearInterval(st.timerId);
        alTerminarFase();
        return;
      }
      pintarTimer();
    }

    function pintarTimer() {
      $('tNum').textContent = fmt(Math.max(0, st.restante));
      $('tFase').textContent = st.fase === 'descanso' ? 'DESCANSO' : `SERIE ${st.serie + 1} / ${st.series}`;
      $('tArco').style.strokeDashoffset = String(CIRC * (1 - st.restante / st.total));
      $('timerWrap').classList.toggle('descanso', st.fase === 'descanso');
      $('timerWrap').classList.toggle('pausado', st.pausado);
      $('tHint').textContent = st.pausado ? 'en pausa' : '';
      $('btnPausa').innerHTML = st.pausado ? conIcono('play', 'Seguir') : conIcono('pause', 'Pausar');
      renderDots();
      persistir();
    }

    function alTerminarFase() {
      if (st.fase === 'trabajo') {
        st.serie++;
        if (st.serie >= st.series) {
          siguienteEjercicio(); // suena el cambio de ejercicio (o el fin)
        } else {
          sonidoFinSerie();
          anunciar(`Descanso de ${st.descanso} segundos`);
          arrancarCuenta(st.descanso, 'descanso');
        }
      } else if (st.fase === 'descanso') {
        sonidoSerie();
        anunciar(`Serie ${st.serie + 1} de ${st.series}`);
        arrancarCuenta(segundosPorSerie(), 'trabajo');
      }
    }

    function empezarEjercicio() {
      if (st.fase !== 'espera') return;
      resetLectura();
      sheetAjustes.cerrar();
      sheetPasos.cerrar();
      initAudio();
      if (!st.sesionActiva) {
        st.sesionActiva = true;
        ponerGuardia(); // avisar antes de perder el progreso al retroceder
      }
      pedirWakeLock();
      cuentaPrevia();
    }

    // Cuenta atrás 3-2-1 antes de arrancar la primera serie del ejercicio
    function cuentaPrevia() {
      st.serie = 0;
      mostrarEstado('cuenta');
      persistir();
      let n = 3;
      pintarCuenta(n);
      sonidoCuenta();
      clearInterval(st.timerId);
      st.timerId = setInterval(() => {
        n--;
        if (n <= 0) {
          clearInterval(st.timerId);
          comenzarTrabajo();
          return;
        }
        pintarCuenta(n);
        sonidoCuenta();
      }, 1000);
    }

    function pintarCuenta(n) {
      const el = $('cuentaNum');
      el.textContent = String(n);
      el.classList.remove('pop');
      void el.offsetWidth; // reinicia la animación de rebote
      el.classList.add('pop');
    }

    function comenzarTrabajo() {
      sonidoInicio();
      anunciar(`Serie 1 de ${st.series}`);
      mostrarEstado('trabajo');
      arrancarCuenta(segundosPorSerie(), 'trabajo');
    }

    function siguienteEjercicio() {
      clearInterval(st.timerId);
      resetLectura();
      if (st.idx + 1 >= rutina.length) {
        terminar();
        return;
      }
      sonidoEjercicio();
      st.idx++;
      st.serie = 0;
      // El siguiente ejercicio siempre espera el comando de voz «ahora»
      renderEjercicio();
      persistir();
      anunciar(`Siguiente ejercicio: ${rutina[st.idx].name}`);
      document.startViewTransition?.(() => {});
    }

    function terminar() {
      sonidoFin();
      mostrarEstado('fin');
      anunciar('Entrenamiento completado');
      st.sesionActiva = false;
      clearSesion();
      quitarGuardia();
      escucha?.stop();
      wakeLock?.release?.();
      const min = Math.max(1, Math.round((Date.now() - st.inicio) / 60000));
      addHistory({ fecha: new Date().toISOString(), dia, ejercicios: rutina.length, duracionMin: min });
      $('pBarra').style.width = '100%';
      const racha = calcularRacha(perfil, getHistory());
      $('finResumen').textContent =
        `${rutina.length} ejercicios · ${min} min · ${DIAS.find((d) => d.id === dia)?.label}` +
        (racha > 1 ? ` · 🔥 ¡Racha de ${racha} días!` : '');
      $('vistaEjercicio').classList.add('oculto');
      $('vistaFin').classList.remove('oculto');
    }

    async function pedirWakeLock() {
      try { wakeLock = await navigator.wakeLock?.request('screen'); } catch { /* opcional */ }
    }

    // ---------- protección al salir (para no perder el progreso) ----------
    // El retroceso del navegador lo intercepta el router de Astro antes que
    // nosotros, así que no se puede cancelar de forma fiable. La red de
    // seguridad real es persistir el progreso (persistir/reanudar): aunque se
    // salga por error, al volver se ofrece continuar. Aquí solo cubrimos el
    // botón «volver» (modal) y la recarga/cierre de pestaña (diálogo nativo).
    let guardiaPuesta = false;

    // Hay progreso que perder desde que arrancas hasta terminar el entrenamiento
    const enCurso = () => st.sesionActiva && st.fase !== 'fin';

    function ponerGuardia() {
      if (guardiaPuesta) return;
      guardiaPuesta = true;
      addEventListener('beforeunload', alBeforeUnload);
    }

    function quitarGuardia() {
      guardiaPuesta = false;
      removeEventListener('beforeunload', alBeforeUnload);
    }

    function alBeforeUnload(e) {
      if (!enCurso()) return;
      e.preventDefault();
      e.returnValue = ''; // navegadores muestran su diálogo nativo de «¿salir?»
    }

    let salirTrasConfirmar = null;
    let pausaPrevia = false;

    function pedirConfirmarSalida(alConfirmar) {
      salirTrasConfirmar = alConfirmar;
      pausaPrevia = st.pausado;
      st.pausado = true; // congela el tiempo mientras decide
      if (st.fase === 'trabajo' || st.fase === 'descanso') pintarTimer();
      $('modalSalir').showModal();
    }

    function cerrarModalSalir() {
      if ($('modalSalir').open) $('modalSalir').close();
      salirTrasConfirmar = null;
      st.pausado = pausaPrevia;
      if (st.fase === 'trabajo' || st.fase === 'descanso') pintarTimer();
    }

    function salirDeVerdad() {
      clearInterval(st.timerId);
      st.sesionActiva = false;
      mostrarEstado('fin');
      clearSesion();
      quitarGuardia();
      callar();
      escucha?.stop();
      wakeLock?.release?.();
      navigate('/rutinas');
    }

    // ---------- reanudar sesión a medias ----------
    function reanudarTimer() {
      mostrarEstado(st.fase); // 'trabajo' o 'descanso'
      clearInterval(st.timerId);
      pintarTimer();
      st.timerId = setInterval(tick, 1000);
    }

    // Restaura una sesión guardada. Devuelve true si había algo que reanudar.
    function intentarReanudar() {
      const s = getSesion();
      // Solo del mismo día, activa y reciente (menos de 3 h)
      if (!s || s.dia !== dia || s.fase === 'fin') return false;
      if (Date.now() - (s.ts || 0) > 3 * 60 * 60 * 1000) { clearSesion(); return false; }
      if (s.idx == null || s.idx >= rutina.length) { clearSesion(); return false; }

      const label = DIAS.find((d) => d.id === dia)?.label ?? dia;
      $('reanudarInfo').textContent =
        `${label} · ejercicio ${s.idx + 1} de ${rutina.length}` +
        (s.fase === 'descanso' ? ' · en descanso' : s.fase === 'trabajo' ? ` · serie ${s.serie + 1}` : '');

      const continuar = () => {
        Object.assign(st, {
          idx: s.idx, serie: s.serie, minPorEjercicio: s.minPorEjercicio,
          series: s.series, descanso: s.descanso, inicio: s.inicio || Date.now(),
          restante: s.restante, total: s.total, pausado: true, sesionActiva: true,
        });
        initAudio();
        ponerGuardia();
        pedirWakeLock();
        pintarEjercicioActual();
        if (s.fase === 'trabajo' || s.fase === 'descanso') {
          st.fase = s.fase;
          reanudarTimer(); // arranca en pausa: se reanuda al tocar
        } else {
          mostrarEstado('espera'); // 'cuenta' o 'espera' → vuelve a esperar el arranque
        }
      };

      $('btnReanudarSi').addEventListener('click', () => {
        sonidoTap();
        $('modalReanudar').close();
        continuar();
      }, { once: true });
      $('btnReanudarNo').addEventListener('click', () => {
        sonidoTap();
        clearSesion();
        $('modalReanudar').close();
      }, { once: true });

      // Escape no la cierra: hay que elegir una de las dos opciones
      $('modalReanudar').addEventListener('cancel', (e) => e.preventDefault());
      $('modalReanudar').showModal();
      return true;
    }

    // ---------- lectura de instrucciones (TTS) ----------
    let leyendo = false;

    function resetLectura() {
      callar();
      leyendo = false;
      $('btnLeer').innerHTML = conIcono('volume', 'Escuchar instrucciones');
      $('btnLeer').classList.remove('leyendo');
    }

    if (!soportaTTS()) $('btnLeer').classList.add('oculto');
    $('btnLeer').addEventListener('click', () => {
      if (leyendo) {
        resetLectura();
        return;
      }
      const ex = rutina[st.idx];
      // Pausa el micrófono mientras habla para que la propia voz no dispare el comando
      const micEstaba = !!escucha?.activo;
      if (micEstaba) escucha.stop();
      leyendo = true;
      $('btnLeer').innerHTML = conIcono('stop', 'Detener lectura');
      $('btnLeer').classList.add('leyendo');
      const texto = ex.steps.map((s, i) => `${i + 1}. ${s}`).join(' ');
      leer(texto, perfil.idioma, () => {
        leyendo = false;
        $('btnLeer').innerHTML = conIcono('volume', 'Escuchar instrucciones');
        $('btnLeer').classList.remove('leyendo');
        if (micEstaba && st.fase === 'espera') escucha.start();
      });
    });

    // ---------- voz ----------
    // El botón del micrófono es un interruptor; su estado se refleja en él y en
    // la línea de ayuda bajo el ejercicio.
    function pintarVoz(estado) {
      const on = estado === 'escuchando';
      $('btnMic').setAttribute('aria-pressed', String(on));
      $('btnMic').innerHTML = icono(on ? 'mic' : 'mic-off');
      $('vozMsg').classList.toggle('escuchando', on);
      $('vozMsg').innerHTML = on
        ? `Di <b>«${voz.palabra}»</b> para empezar`
        : 'Toca <b>Empezar</b> cuando estés en posición';
      $('vozEstado').textContent =
        estado === 'denegado' ? 'Micrófono denegado: usa el botón para empezar'
        : estado === 'sin-soporte' ? ''
        : on ? 'Escuchando…'
        : `O activa el micrófono y di «${voz.palabra}»`;
    }

    function activarMic() {
      initAudio();
      if (!escucha) {
        escucha = crearEscucha({
          idioma: perfil.idioma,
          onComando: () => {
            if (st.fase === 'espera') empezarEjercicio();
          },
          onEstado: pintarVoz,
        });
      }
      escucha?.start();
    }

    if (soportaVoz()) pintarVoz('apagado');
    else {
      $('btnMic').classList.add('oculto');
      pintarVoz('sin-soporte');
    }

    // ---------- eventos ----------
    $('btnMic').addEventListener('click', () => {
      initAudio();
      sonidoTap();
      if (escucha?.activo) escucha.stop();
      else activarMic();
    });
    $('btnAjustar').addEventListener('click', () => { sonidoTap(); sheetAjustes.abrir(); });
    $('btnPasos').addEventListener('click', () => { sonidoTap(); sheetPasos.abrir(); });
    $('btnManual').addEventListener('click', empezarEjercicio);
    $('btnSaltar').addEventListener('click', () => { sonidoTap(); siguienteEjercicio(); });
    const alternarPausa = () => {
      if (st.fase === 'trabajo' || st.fase === 'descanso') {
        st.pausado = !st.pausado;
        sonidoTap();
        pintarTimer();
        anunciar(st.pausado ? 'En pausa' : 'Seguimos');
      }
    };
    $('timerWrap').addEventListener('click', alternarPausa);
    $('btnPausa').addEventListener('click', alternarPausa);

    // Botón «volver»: si hay entrenamiento en curso, pregunta antes de salir
    $('btnVolver').addEventListener('click', (e) => {
      if (enCurso()) {
        e.preventDefault();
        sonidoTap();
        pedirConfirmarSalida(() => salirDeVerdad());
      }
    });

    // Botones del modal de salida
    $('btnSalirSi').addEventListener('click', () => {
      const salir = salirTrasConfirmar;
      $('modalSalir').close();
      salirTrasConfirmar = null;
      salir?.();
    });
    $('btnSalirNo').addEventListener('click', () => { sonidoTap(); cerrarModalSalir(); });
    // Escape equivale a «Seguir entrenando»
    $('modalSalir').addEventListener('cancel', (e) => { e.preventDefault(); cerrarModalSalir(); });


    // Limpieza al salir de la página (view transitions no recargan)
    document.addEventListener('astro:before-swap', () => {
      clearInterval(st.timerId);
      callar();
      escucha?.stop();
      wakeLock?.release?.();
      quitarGuardia();
    }, { once: true });

    renderEjercicio();
    intentarReanudar(); // si quedó un entrenamiento a medias, ofrece continuarlo
  });
</script>
