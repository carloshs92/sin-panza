---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Editar rutina">
  <div id="editor" class="stack">
    <TopBar volver="/rutinas" tituloId="eDia" subId="eResumen" />

    <ol class="lista" id="listaEx"></ol>

    <a class="btn btn-secondary" id="btnAnadir" href="#"><Icon nombre="plus" /> Añadir ejercicio</a>
    <a class="btn" id="btnEntrenar" href="#"><Icon nombre="play" /> Entrenar este día</a>
  </div>
</Base>

<style>
  #editor { gap: var(--s-5); }
  .lista { display: flex; flex-direction: column; gap: var(--s-2); list-style: none; }

  .lista :global(.ex-fila) {
    display: flex; align-items: center; gap: var(--s-3);
    padding: var(--s-3);
    border-radius: var(--r-lg);
    background: var(--surface-1);
    border: 1px solid var(--line);
  }
  .lista :global(.ex-fila .media-frame) { width: 52px; height: 52px; }
  .lista :global(.ex-datos) { flex: 1; min-width: 0; }
  .lista :global(.ex-datos b),
  .lista :global(.ex-meta) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lista :global(.ex-datos b) { font-size: var(--t-sm); text-transform: capitalize; }
  .lista :global(.ex-meta) { margin-top: 2px; font-size: var(--t-xs); color: var(--fg-muted); }

  .lista :global(.ex-btns) { display: grid; grid-template-columns: repeat(2, var(--tap)); gap: var(--s-1); flex-shrink: 0; }
  .lista :global(.ex-btns .icon-btn) { font-size: var(--t-md); }
  .lista :global(.ex-btns .quitar) { color: var(--danger); }

  .vacio { padding: var(--s-6) var(--s-3); text-align: center; color: var(--fg-muted); }
</style>

<script>
  import { getProfile, getRoutineDay, saveRoutineDay, getSettings, DIAS } from '../lib/db.js';
  import { mediaUrl, precargar } from '../lib/media.js';
  import { duracionEstimadaMin } from '../lib/plan.js';
  import { musculo, equipamiento } from '../lib/textos.js';
  import { icono } from '../lib/iconos.js';
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('editor');
    if (!root) return;

    const $ = (id) => root.querySelector('#' + id);
    const dia = new URLSearchParams(location.search).get('dia');
    const perfil = getProfile();
    if (!perfil || !dia || !perfil.dias.includes(dia)) {
      navigate('/rutinas', { history: 'replace' });
      return;
    }

    const settings = getSettings();
    let ejercicios = getRoutineDay(dia);

    $('eDia').textContent = DIAS.find((d) => d.id === dia)?.label ?? dia;
    $('btnEntrenar').href = `/entrenar?dia=${dia}`;
    $('btnAnadir').href = `/buscar?dia=${dia}&pos=nueva`;

    const guardar = () => {
      saveRoutineDay(dia, ejercicios);
      pintar();
    };

    function pintar() {
      $('eResumen').textContent =
        `${ejercicios.length} ejercicios · ~${duracionEstimadaMin(ejercicios.length, settings)} min`;

      const lista = $('listaEx');
      if (ejercicios.length === 0) {
        lista.innerHTML = '<li class="vacio">Este día no tiene ejercicios.<br />Añade uno para empezar.</li>';
        return;
      }

      lista.innerHTML = ejercicios
        .map(
          (e, i) => `
        <li class="ex-fila">
          <div class="media-frame"><img src="${mediaUrl(e.image)}" alt="" loading="lazy" decoding="async" /></div>
          <div class="ex-datos">
            <b>${e.name}</b>
            <div class="ex-meta">${musculo(e.target)} · ${equipamiento(e.equipment)}</div>
          </div>
          <div class="ex-btns">
            <button class="icon-btn" data-accion="subir" data-i="${i}" ${i === 0 ? 'disabled' : ''} aria-label="Subir">${icono('arrow-up')}</button>
            <button class="icon-btn" data-accion="bajar" data-i="${i}" ${i === ejercicios.length - 1 ? 'disabled' : ''} aria-label="Bajar">${icono('arrow-down')}</button>
            <button class="icon-btn" data-accion="cambiar" data-i="${i}" aria-label="Cambiar ejercicio">${icono('arrow-left-right')}</button>
            <button class="icon-btn quitar" data-accion="quitar" data-i="${i}" aria-label="Quitar">${icono('trash')}</button>
          </div>
        </li>`
        )
        .join('');

      // Las miniaturas de este día quedan en caché para la próxima visita
      precargar(ejercicios.map((e) => e.image));
    }

    $('listaEx').addEventListener('click', (ev) => {
      const btn = ev.target.closest('button[data-accion]');
      if (!btn) return;
      const i = Number(btn.dataset.i);
      const accion = btn.dataset.accion;

      if (accion === 'subir' && i > 0) {
        [ejercicios[i - 1], ejercicios[i]] = [ejercicios[i], ejercicios[i - 1]];
        guardar();
      } else if (accion === 'bajar' && i < ejercicios.length - 1) {
        [ejercicios[i], ejercicios[i + 1]] = [ejercicios[i + 1], ejercicios[i]];
        guardar();
      } else if (accion === 'quitar') {
        ejercicios.splice(i, 1);
        guardar();
      } else if (accion === 'cambiar') {
        navigate(`/buscar?dia=${dia}&pos=${i}`);
      }
    });

    pintar();
  });
</script>
