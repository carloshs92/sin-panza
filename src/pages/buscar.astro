---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Buscar ejercicio" ancho="ancho">
  <div id="buscador" class="buscador">
    <TopBar volver="/rutinas" volverId="btnVolver" titulo="Elegir ejercicio" tituloId="bTitulo" subId="bSub" />

    <aside class="filtros">
      <label class="campo-icono">
        <Icon nombre="search" />
        <input type="search" id="q" class="input" placeholder="Buscar por nombre o músculo…" autocomplete="off" aria-label="Buscar ejercicio" />
      </label>
      <div class="chips carrusel" id="catChips"></div>
      <label class="switch">
        <input type="checkbox" id="soloMio" checked />
        <span>Solo lo que puedo hacer con mi equipo</span>
      </label>
    </aside>

    <section class="col-resultados">
      <p class="muted conteo" id="conteo" aria-live="polite">—</p>
      <div class="resultados" id="resultados"></div>
      <div id="centinela"></div>
      <p class="muted fin-lista oculto" id="finLista">— fin de los resultados —</p>
    </section>
  </div>
</Base>

<style>
  /* Móvil: todo en una columna. ≥ 900: filtros en una barra lateral fija y
     resultados en rejilla. */
  /* minmax(0, 1fr): sin él, los textos nowrap ensanchan la columna implícita */
  .buscador { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
  .filtros { display: flex; flex-direction: column; gap: var(--s-3); }
  .col-resultados { display: flex; flex-direction: column; gap: var(--s-3); min-width: 0; }

  @media (min-width: 900px) {
    .buscador {
      grid-template-columns: 280px minmax(0, 1fr);
      grid-template-areas: 'top top' 'filtros resultados';
      column-gap: var(--s-6);
      align-items: start;
    }
    .buscador > :global(.topbar) { grid-area: top; }
    .filtros { grid-area: filtros; position: sticky; top: var(--shell-top); }
    .col-resultados { grid-area: resultados; }
    /* En la barra lateral hay sitio: las zonas se envuelven en vez de deslizar */
    .filtros .carrusel { flex-wrap: wrap; overflow: visible; margin-inline: 0; padding-inline: 0; }
  }
  /* Las zonas se deslizan en una fila: con 8 chips, envolver ocupaba media pantalla */
  .carrusel { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--s-4)); padding-inline: var(--s-4); }
  .carrusel::-webkit-scrollbar { display: none; }
  .carrusel :global(.chip) { flex-shrink: 0; }

  .conteo { font-size: var(--t-sm); }

  .resultados { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-2); }
  @media (min-width: 600px) {
    .resultados { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  }
  .resultados :global(.res) {
    display: flex; align-items: center; gap: var(--s-3);
    width: 100%; padding: var(--s-3);
    border-radius: var(--r-lg);
    background: var(--surface-1);
    border: 1px solid var(--line);
    text-align: left;
    transition: background var(--dur-1), transform var(--dur-1) var(--ease-out);
  }
  .resultados :global(.res:active) { transform: scale(0.98); }
  @media (hover: hover) { .resultados :global(.res:hover) { background: var(--surface-2); } }
  .resultados :global(.res .media-frame) { width: 56px; height: 56px; }
  .resultados :global(.res-datos) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--s-1); }
  .resultados :global(.res-datos b) {
    font-size: var(--t-sm); text-transform: capitalize;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .resultados :global(.res-tags) { display: flex; flex-wrap: wrap; gap: var(--s-1); }
  .resultados :global(.ya) { font-size: var(--t-xs); font-weight: 600; color: var(--success); }
  .resultados :global(.flecha) { flex-shrink: 0; font-size: var(--t-lg); color: var(--fg-subtle); }

  .fin-lista, .resultados :global(.vacio) { padding: var(--s-5); text-align: center; font-size: var(--t-sm); }
  .resultados :global(.vacio) { grid-column: 1 / -1; }
  #centinela { height: 1px; }
</style>

<script>
  import { getProfile, getRoutineDay, saveRoutineDay, CATEGORIAS, DIAS } from '../lib/db.js';
  import { cargarEjercicios, equipoPermitido, estructurasPermitidas } from '../lib/plan.js';
  import { mediaUrl, precargar } from '../lib/media.js';
  import { musculo, equipamiento } from '../lib/textos.js';
  import { icono } from '../lib/iconos.js';
  import { marcarChip } from '../lib/ui.js';
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', async () => {
    const root = document.getElementById('buscador');
    if (!root) return;

    const $ = (id) => root.querySelector('#' + id);
    const params = new URLSearchParams(location.search);
    const dia = params.get('dia');
    const pos = params.get('pos'); // índice a reemplazar, o "nueva" para añadir
    const perfil = getProfile();
    if (!perfil || !dia || !perfil.dias.includes(dia)) {
      navigate('/rutinas', { history: 'replace' });
      return;
    }

    const rutina = getRoutineDay(dia);
    const enRutina = new Set(rutina.map((e) => e.id));
    const reemplazando = pos !== 'nueva';
    const actual = reemplazando ? rutina[Number(pos)] : null;

    $('btnVolver').href = `/editar?dia=${dia}`;
    $('bTitulo').textContent = reemplazando ? 'Cambiar ejercicio' : 'Añadir ejercicio';
    $('bSub').textContent = reemplazando && actual
      ? `${DIAS.find((d) => d.id === dia)?.label} · sustituye a "${actual.name}"`
      : DIAS.find((d) => d.id === dia)?.label ?? '';

    // ---- filtros ----
    const permitido = equipoPermitido(perfil);
    const estructuras = estructurasPermitidas(perfil);
    const puedeHacerlo = (e) => {
      if (permitido && !permitido.has(e.equipment)) return false;
      if (e.req && estructuras && !estructuras.has(e.req)) return false;
      return true;
    };

    let categoria = null;
    let texto = '';
    let soloMio = true;

    const catBox = $('catChips');
    CATEGORIAS.forEach((c) => {
      const b = document.createElement('button');
      b.className = 'chip';
      marcarChip(b, false);
      b.textContent = c.label;
      b.addEventListener('click', () => {
        categoria = categoria === c.id ? null : c.id;
        catBox.querySelectorAll('.chip').forEach((x) => marcarChip(x, x === b && !!categoria));
        filtrar();
      });
      catBox.appendChild(b);
    });

    $('q').addEventListener('input', (ev) => {
      texto = ev.target.value.toLowerCase().trim();
      filtrar();
    });
    $('soloMio').addEventListener('change', (ev) => {
      soloMio = ev.target.checked;
      filtrar();
    });

    // ---- datos ----
    $('conteo').textContent = 'Cargando ejercicios…';
    const todos = await cargarEjercicios(perfil.idioma);

    let filtrados = [];
    let pintados = 0;
    const LOTE = 30;

    function filtrar() {
      filtrados = todos.filter((e) => {
        if (soloMio && !puedeHacerlo(e)) return false;
        if (categoria && e.category !== categoria) return false;
        if (texto && ![e.name, e.target, musculo(e.target)].some((x) => x.toLowerCase().includes(texto))) return false;
        return true;
      });
      pintados = 0;
      $('resultados').innerHTML = '';
      $('conteo').textContent = `${filtrados.length} ejercicios disponibles`;
      $('finLista').classList.add('oculto');
      pintarLote();
    }

    // Render incremental: 1.324 ejercicios de golpe serían miles de imágenes
    function pintarLote() {
      const lote = filtrados.slice(pintados, pintados + LOTE);
      if (lote.length === 0) {
        if (filtrados.length === 0) {
          $('resultados').innerHTML = '<p class="vacio muted">No hay ejercicios con esos filtros.<br />Prueba desactivar «solo lo que puedo hacer».</p>';
        } else {
          $('finLista').classList.remove('oculto');
        }
        return;
      }

      const html = lote
        .map(
          (e) => `
        <button class="res" data-id="${e.id}">
          <div class="media-frame"><img src="${mediaUrl(e.image)}" alt="" loading="lazy" decoding="async" /></div>
          <div class="res-datos">
            <b>${e.name}</b>
            <div class="res-tags">
              <span class="tag">${musculo(e.target)}</span>
              <span class="tag">${equipamiento(e.equipment)}</span>
              ${e.req ? `<span class="tag">necesita ${e.req === 'barra' ? 'barra' : 'banco'}</span>` : ''}
            </div>
            ${enRutina.has(e.id) ? `<span class="ya con-icono">${icono('check')} ya está en esta rutina</span>` : ''}
          </div>
          <span class="flecha">${icono('chevron-right')}</span>
        </button>`
        )
        .join('');
      $('resultados').insertAdjacentHTML('beforeend', html);
      pintados += lote.length;
      precargar(lote.map((e) => e.image));
    }

    // Scroll infinito
    new IntersectionObserver((entradas) => {
      if (entradas[0].isIntersecting && filtrados.length) pintarLote();
    }, { rootMargin: '400px' }).observe($('centinela'));

    // ---- elegir ----
    $('resultados').addEventListener('click', (ev) => {
      const btn = ev.target.closest('.res');
      if (!btn) return;
      const elegido = todos.find((e) => e.id === btn.dataset.id);
      if (!elegido) return;

      const lista = getRoutineDay(dia);
      if (reemplazando) lista[Number(pos)] = elegido;
      else lista.push(elegido);
      saveRoutineDay(dia, lista);
      navigate(`/editar?dia=${dia}`);
    });

    filtrar();
  });
</script>
