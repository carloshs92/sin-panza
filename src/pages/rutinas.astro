---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Mis rutinas" nav="rutinas">
  <div id="rutinas" class="stack">
    <header class="cab">
      <p class="muted" id="saludo">Hola 👋</p>
      <h1>Tu semana</h1>
    </header>

    <!-- Estado de hoy: si toca entrenar, es la acción principal de la pantalla -->
    <a class="hoy-card" id="hoyCard" href="#"></a>

    <!-- Estadísticas -->
    <div class="stats">
      <div class="stat card"><b id="stRacha">0</b><span class="con-icono"><Icon nombre="flame" />racha</span></div>
      <div class="stat card"><b id="stMes">0</b><span class="con-icono"><Icon nombre="calendar" />este mes</span></div>
      <div class="stat card"><b id="stTotal">0</b><span class="con-icono"><Icon nombre="circle-check" />total</span></div>
    </div>

    <!-- Calendario del mes -->
    <section class="card cal">
      <div class="cal-head">
        <h2 id="calTitulo">—</h2>
        <span class="muted" id="calResumen"></span>
      </div>
      <div class="cal-grid cal-labels" aria-hidden="true">
        <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
      </div>
      <div class="cal-grid" id="calDias"></div>
    </section>

    <section class="stack">
      <h2 class="eyebrow">Rutinas</h2>
      <div class="lista" id="listaDias"></div>
    </section>
  </div>
</Base>

<style>
  .cab { display: flex; flex-direction: column; gap: var(--s-1); }

  /* ---- hoy ---- */
  .hoy-card {
    display: block;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-lg);
    background: var(--surface-1);
    border: 1px solid var(--line);
    transition: transform var(--dur-1) var(--ease-out);
  }
  .hoy-card:active { transform: scale(0.98); }
  .hoy-card.pendiente { background: var(--accent); border-color: transparent; color: var(--accent-fg); }
  .hoy-card.cumplido { background: var(--success-soft); border-color: var(--success); }
  .hoy-card :global(.hc-titulo) { display: flex; align-items: center; gap: var(--s-2); font-size: var(--t-lg); font-weight: 700; }
  .hoy-card :global(.hc-sub) { margin-top: var(--s-1); font-size: var(--t-sm); color: var(--fg-muted); }
  .hoy-card.pendiente :global(.hc-sub) { color: inherit; opacity: 0.85; }

  /* ---- estadísticas ---- */
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); }
  .stat { display: flex; flex-direction: column; align-items: center; gap: var(--s-1); padding: var(--s-3) var(--s-2); text-align: center; }
  .stat b { font-size: var(--t-xl); line-height: 1; font-variant-numeric: tabular-nums; }
  .stat span { gap: var(--s-1); font-size: var(--t-xs); color: var(--fg-muted); }

  /* ---- calendario ---- */
  .cal-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--s-2); margin-bottom: var(--s-3); }
  .cal-head h2 { font-size: var(--t-md); }
  .cal-head span { font-size: var(--t-sm); }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--s-1); }
  .cal-labels { margin-bottom: var(--s-1); }
  .cal-labels span { text-align: center; font-size: var(--t-xs); font-weight: 700; color: var(--fg-subtle); }

  .cal-grid :global(.cd) {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1;
    border-radius: var(--r-sm);
    background: var(--surface-2);
    font-size: var(--t-sm); font-weight: 600;
    color: var(--fg-muted);
  }
  .cal-grid :global(.cd.vacio) { background: none; }
  .cal-grid :global(.cd.prog)::after {
    content: ''; position: absolute; bottom: 12%;
    width: 4px; height: 4px; border-radius: var(--r-full); background: var(--fg-subtle);
  }
  .cal-grid :global(.cd.hecho) { background: var(--success); color: var(--success-fg); font-weight: 800; }
  .cal-grid :global(.cd.hecho)::after { display: none; }
  /* Fallado: sin castigo visual, solo más apagado que el resto */
  .cal-grid :global(.cd.fallado) { background: transparent; box-shadow: inset 0 0 0 1px var(--line); color: var(--fg-subtle); }
  .cal-grid :global(.cd.hoy) { box-shadow: inset 0 0 0 2px var(--fg); color: var(--fg); }
  .cal-grid :global(.cd.futuro) { background: transparent; color: var(--fg-subtle); }

  /* ---- rutinas de la semana ---- */
  .lista { display: flex; flex-direction: column; gap: var(--s-3); }
  .lista :global(.dia-card) {
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--surface-1);
    border: 1px solid var(--line);
  }
  .lista :global(.dia-card.hoy) { border-color: var(--line-strong); }
  .lista :global(.dia-main) { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-4); }
  .lista :global(.dia-top) { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-1) var(--s-3); }
  .lista :global(.dia-top h3) { display: flex; align-items: center; gap: var(--s-2); font-size: var(--t-lg); }
  .lista :global(.dia-top .tag) { color: var(--fg); }
  .lista :global(.dia-meta) { font-size: var(--t-sm); color: var(--fg-muted); }

  /* Hasta 4 miniaturas + «+N» en 5 columnas: caben a cualquier ancho */
  .lista :global(.thumbs) { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--s-2); }
  .lista :global(.thumbs .media-frame) { aspect-ratio: 1; }
  .lista :global(.thumbs .mas) {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1; border-radius: var(--r-md);
    background: var(--surface-2); color: var(--fg-muted);
    font-size: var(--t-sm); font-weight: 700;
  }
  .lista :global(.hecho-hoy) { font-size: var(--t-sm); font-weight: 600; color: var(--success); }
  .lista :global(.dia-editar) {
    display: flex; align-items: center; justify-content: center;
    min-height: var(--tap);
    border-top: 1px solid var(--line);
    font-size: var(--t-sm); font-weight: 600; color: var(--fg-muted);
  }
  @media (hover: hover) {
    .lista :global(.dia-main:hover) { background: var(--surface-2); }
    .lista :global(.dia-editar:hover) { color: var(--fg); background: var(--surface-2); }
  }
</style>

<script>
  import { getProfile, getRoutines, getSettings, getHistory, calcularRacha, DIAS, diaHoy, diaDe } from '../lib/db.js';
  import { mediaUrl, precargar } from '../lib/media.js';
  import { duracionEstimadaMin } from '../lib/plan.js';
  import { escapar, mayusInicial } from '../lib/textos.js';
  import { icono } from '../lib/iconos.js';
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('rutinas');
    if (!root) return;

    const perfil = getProfile();
    if (!perfil) {
      navigate('/', { history: 'replace' });
      return;
    }

    const rutinas = getRoutines();
    const settings = getSettings();
    const historial = getHistory();
    const hoy = diaHoy();
    const ahora = new Date();
    const hoyStr = ahora.toDateString();
    const hechos = new Set(historial.map((h) => new Date(h.fecha).toDateString()));

    // ---- saludo + stats ----
    const nombre = escapar(perfil.nombre ?? '');
    root.querySelector('#saludo').textContent = `Hola, ${perfil.nombre || 'crack'} 👋`;
    const esteMes = historial.filter((h) => {
      const f = new Date(h.fecha);
      return f.getMonth() === ahora.getMonth() && f.getFullYear() === ahora.getFullYear();
    }).length;
    root.querySelector('#stRacha').textContent = String(calcularRacha(perfil, historial));
    root.querySelector('#stMes').textContent = String(esteMes);
    root.querySelector('#stTotal').textContent = String(historial.length);

    // ---- tarjeta de hoy ----
    const hoyCard = root.querySelector('#hoyCard');
    const programadoHoy = perfil.dias.includes(hoy);
    const cumplidoHoy = hechos.has(hoyStr);
    if (cumplidoHoy) {
      hoyCard.className = 'hoy-card cumplido';
      hoyCard.href = '/rutinas';
      hoyCard.innerHTML = `<div class="hc-titulo">${icono('trophy')} ¡Objetivo de hoy cumplido!</div>
        <div class="hc-sub">Ya entrenaste hoy${nombre ? `, ${nombre}` : ''}. Descansa o repite si te sobran ganas 💪</div>`;
    } else if (programadoHoy) {
      const n = (rutinas[hoy] || []).length;
      hoyCard.className = 'hoy-card pendiente';
      hoyCard.href = `/entrenar?dia=${hoy}`;
      hoyCard.innerHTML = `<div class="hc-titulo">${icono('play')} Hoy toca entrenar</div>
        <div class="hc-sub">${n} ejercicios · ~${duracionEstimadaMin(n, settings)} min con descansos. ¡Dale!</div>`;
    } else {
      hoyCard.className = 'hoy-card';
      hoyCard.href = '/rutinas';
      hoyCard.innerHTML = `<div class="hc-titulo">${icono('moon')} Hoy es día de descanso</div>
        <div class="hc-sub">Tu próximo entrenamiento aparece abajo. ¿Ganas extra? Toca cualquier rutina.</div>`;
    }

    // ---- calendario del mes ----
    const y = ahora.getFullYear();
    const m = ahora.getMonth();
    const diasEnMes = new Date(y, m + 1, 0).getDate();
    const offset = (new Date(y, m, 1).getDay() + 6) % 7; // lunes = 0
    root.querySelector('#calTitulo').textContent = mayusInicial(ahora.toLocaleDateString('es', { month: 'long', year: 'numeric' }));

    const calBox = root.querySelector('#calDias');
    let cumplidosMes = 0;
    let programadosMes = 0;
    // Los días anteriores a crear el plan no cuentan como fallados
    const inicioPlan = perfil.creado ? new Date(new Date(perfil.creado).toDateString()) : null;
    let html = '<span class="cd vacio"></span>'.repeat(offset);
    for (let d = 1; d <= diasEnMes; d++) {
      const fecha = new Date(y, m, d);
      const esFuturo = fecha > ahora && fecha.toDateString() !== hoyStr;
      const programado = perfil.dias.includes(diaDe(fecha)) && !(inicioPlan && fecha < inicioPlan);
      const hecho = hechos.has(fecha.toDateString());
      if (programado && !esFuturo) programadosMes++;
      if (hecho) cumplidosMes++;
      const cls = [
        'cd',
        programado ? 'prog' : '',
        hecho ? 'hecho' : '',
        !hecho && programado && !esFuturo && fecha.toDateString() !== hoyStr ? 'fallado' : '',
        fecha.toDateString() === hoyStr ? 'hoy' : '',
        esFuturo ? 'futuro' : '',
      ].filter(Boolean).join(' ');
      html += `<span class="${cls}">${d}</span>`;
    }
    calBox.innerHTML = html;
    root.querySelector('#calResumen').textContent = `${cumplidosMes}/${programadosMes} días cumplidos`;

    // ---- lista de rutinas ----
    const lista = root.querySelector('#listaDias');
    const orden = [...perfil.dias].sort((a, b) => {
      const ids = DIAS.map((d) => d.id);
      // El día de hoy primero, luego el resto de la semana en orden
      const rank = (x) => (ids.indexOf(x) - ids.indexOf(hoy) + 7) % 7;
      return rank(a) - rank(b);
    });

    orden.forEach((diaId) => {
      const info = DIAS.find((d) => d.id === diaId);
      const ejercicios = rutinas[diaId] || [];
      const esHoy = diaId === hoy;
      const hechoHoy = esHoy && cumplidoHoy;
      const totalMin = duracionEstimadaMin(ejercicios.length, settings);

      const card = document.createElement('div');
      card.className = `dia-card ${esHoy ? 'hoy' : ''}`;
      card.style.viewTransitionName = `dia-${diaId}`;

      const thumbs = ejercicios
        .slice(0, 4)
        .map((e) => `<div class="media-frame"><img src="${mediaUrl(e.image)}" alt="" loading="lazy" decoding="async" /></div>`)
        .join('');
      const extra = ejercicios.length > 4 ? `<div class="mas">+${ejercicios.length - 4}</div>` : '';

      card.innerHTML = `
        <a class="dia-main" href="/entrenar?dia=${diaId}">
          <div class="dia-top">
            <h3>${info?.label ?? diaId} ${esHoy ? '<span class="tag">Hoy</span>' : ''}</h3>
            <span class="dia-meta">${ejercicios.length} ejercicios · ~${totalMin} min</span>
          </div>
          <div class="thumbs">${thumbs}${extra}</div>
          ${hechoHoy ? `<div class="hecho-hoy con-icono">${icono('circle-check')} Completado hoy</div>` : ''}
        </a>
        <a class="dia-editar con-icono" href="/editar?dia=${diaId}">${icono('pencil')} Editar rutina</a>
      `;
      lista.appendChild(card);
    });

    // Deja lista la caché del media de toda la semana (miniaturas y GIFs del día de hoy)
    precargar(orden.flatMap((d) => (rutinas[d] || []).map((e) => e.image)));
    precargar((rutinas[hoy] || []).slice(0, 2).map((e) => e.gif));
  });
</script>
