---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  nav?: 'rutinas' | 'ajustes' | null;
}
const { title, nav = null } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SinPanza" />
    {/* Pantallas de arranque de iOS: solo se usa la que coincide exactamente
        con el dispositivo. Se regeneran con scripts/generar-graficos.py */}
    {[
      [440, 956, 3], [430, 932, 3], [402, 874, 3], [393, 852, 3], [390, 844, 3],
      [414, 896, 3], [414, 896, 2], [375, 812, 3], [414, 736, 3], [375, 667, 2],
    ].map(([w, h, dpr]) => (
      <link
        rel="apple-touch-startup-image"
        media={`(device-width: ${w}px) and (device-height: ${h}px) and (-webkit-device-pixel-ratio: ${dpr}) and (orientation: portrait)`}
        href={`/splash/splash-${w * dpr}x${h * dpr}.png`}
      />
    ))}
    <script is:inline>
      // Captura temprana del evento de instalación PWA (Ajustes lo usa)
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.__installPrompt = e;
        window.dispatchEvent(new CustomEvent('sp:instalable'));
      });
      // Aviso de falta de red (se mantiene entre navegaciones con view transitions)
      if (!window.__redVigilada) {
        window.__redVigilada = true;
        const pintarRed = () => {
          const el = document.getElementById('sinRed');
          if (el) el.classList.toggle('oculto', navigator.onLine);
        };
        addEventListener('online', pintarRed);
        addEventListener('offline', pintarRed);
        document.addEventListener('astro:page-load', pintarRed);
      }
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // En dev (vite) no se registra: cachearía los módulos y verías código viejo
          if (!document.querySelector('script[src^="/@vite/"]')) navigator.serviceWorker.register('/sw.js');
        });
      }
    </script>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · SinPanza</title>
    <ClientRouter />
  </head>
  <body>
    <IconSprite />
    {/* Splash propio (Android/escritorio, y relevo del de iOS). transition:persist
        evita que se repita en cada navegación; se oculta solo con CSS. */}
    <div id="splash" transition:persist>
      <div class="splash-logo">
        <span></span><span></span><span></span>
      </div>
      <b>Sin<i>Panza</i></b>
    </div>
    <div id="sinRed" class="sin-red oculto" role="status"><Icon nombre="wifi-off" /> Sin conexión — usando lo que tienes guardado</div>
    <main class:list={['shell', { 'sin-nav': !nav }]}>
      <slot />
    </main>
    {nav && (
      <nav class="bottom-nav">
        <a href="/rutinas" class={nav === 'rutinas' ? 'active' : ''}>
          <Icon nombre="dumbbell" />
          Rutinas
        </a>
        <a href="/ajustes" class={nav === 'ajustes' ? 'active' : ''}>
          <Icon nombre="settings" />
          Ajustes
        </a>
      </nav>
    )}
  </body>
</html>
