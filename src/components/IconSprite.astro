---
// Sprite con todos los iconos: se incluye una vez en Base.astro.
import { ICONOS } from '../lib/iconos.js';
---
<svg xmlns="http://www.w3.org/2000/svg" style="display: none" aria-hidden="true">
  {Object.entries(ICONOS).map(([nombre, trazos]) => (
    <symbol
      id={`i-${nombre}`}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={trazos}
    />
  ))}
</svg>
